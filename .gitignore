# secrets
.env

# python
.venv/
__pycache__/
*.pyc

# node (web/ is the Next.js read layer; root tooling stays Python-only)
web/node_modules/
web/.next/
web/.env*.local
web/next-env.d.ts
web/*.tsbuildinfo

# sqlite working files. data/psephos.db is the local-dev fallback backend, a
# working artifact only -- it has never been tracked (`git log --all -- '*.db'`
# is empty across the full history) and must not be, since it can carry the
# whole items spine as a binary blob. Ignore it and its WAL sidecars.
data/psephos.db
data/psephos.db-wal
data/psephos.db-shm

# offline election-filter-tuning corpus: ~14.5MB, too big to commit; rebuild with
# `python -m tools.masterlist_corpus` (nine queries). The script is the reproducible path.
data/masterlist_corpus.json

# offline sasts probe corpus (handoff 11 / 5b-b): the state_bills dimension's outward
# relations; rebuild with `python -m tools.sasts_dump` (~455 queries). The script is
# the reproducible path.
data/sasts_corpus.json

# cases.status drift measurement (handoff 26): stored status vs CourtListener today;
# rebuild with `python -m tools.status_audit` (40 queries). The script is the
# reproducible path. Deliberately NOT byte-stable -- it tracks a moving upstream value.
data/status_audit.json

# vercel. `vercel link` writes .vercel/project.json (projectId + orgId) into the
# linked directory. Nothing covered it before this rule -- not the repo file and not
# ~/.gitignore_global -- so `git check-ignore -v .vercel/project.json` returned
# nothing and the link would have written into a trackable path. The ids are account
# identifiers rather than secrets, but they are machine-local link state and do not
# belong in the tree. Added BEFORE the first link, not after.
.vercel/

# claude code. Writes .claude/scheduled_tasks.lock into the repo root. Same shape as
# .vercel/ above and confirmed the same way: `git check-ignore -v .claude` returned
# nothing before this rule -- not the repo file, not ~/.gitignore_global -- so a
# tool-written lock file was sitting in a trackable path with nothing covering it.
# Machine-local session state, not a repo artifact.
.claude/

# os
.DS_Store
Thumbs.db
