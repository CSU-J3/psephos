# sqlite working files. data/psephos.db is the local-dev fallback backend, a
# working artifact only -- it has never been tracked (`git log --all -- '*.db'`
# is empty across the full history) and must not be, since it can carry the
# whole items spine as a binary blob. Ignore it and its WAL sidecars.
data/psephos.db
data/psephos.db-wal
data/psephos.db-shm

# offline election-filter-tuning corpus: ~14.5MB, too big to commit; rebuild with
# `python -m tools.masterlist_corpus` (nine queries). The script is the reproducible path.
data/masterlist_corpus.json

# offline sasts probe corpus (handoff 11 / 5b-b): the state_bills dimension's outward
# relations; rebuild with `python -m tools.sasts_dump` (~455 queries). The script is
# the reproducible path.
data/sasts_corpus.json

